# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# JWT signing secret — use a long, random string in production.
JWT_SECRET="change-me-to-a-long-random-secret-in-production"

# Google OAuth — Client IDs from Google Cloud Console.
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_IOS_CLIENT_ID="your-google-ios-client-id.apps.googleusercontent.com"
RESEND_API_KEY="re_ta_vraie_cle"
GEMINI_API_KEY="your-gemini-api-key"
